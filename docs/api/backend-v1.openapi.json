    "/comments": {
      "get": {
        "summary": "Guestbook root feed across registered entities; RLS public + own + owner",
        "security": [],
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
