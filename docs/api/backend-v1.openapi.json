                  "expectedVersion": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  }
                }
              }
            }
          }
        }
      }
    },
    "/comments/{commentId}/moderate": {
      "parameters": [
        {
          "in": "path",
          "name": "commentId",
          "required": true,
          "schema": {
            "type": "string",
