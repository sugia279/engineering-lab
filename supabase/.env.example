# Local Edge environment, not browser config. Supabase injects URL + anon key.
ALLOWED_ORIGINS=http://localhost:4321,http://127.0.0.1:4321
# Configure a local OAuth app through supabase/config.toml; never commit secrets.
SUPABASE_AUTH_EXTERNAL_GITHUB_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GITHUB_SECRET=
