---
/**
 * PrimaryNavigation — desktop primary nav from typed configuration.
 * Registry: Site component, M7.
 */
import type { NavigationItem } from '../../types/navigation';
import { buildUrl } from '../../utils/url';

interface Props {
  items: readonly NavigationItem[];
  currentPath?: string;
}

const { items, currentPath = '' } = Astro.props;

function isActive(item: NavigationItem): boolean {
  if (!item.matchPattern) return false;
  return currentPath.includes(item.matchPattern);
}
---

<nav aria-label="Primary navigation" class="primary-nav">
  <ul class="primary-nav__list" role="list">
    {items.map((item) => {
      const active = isActive(item);
      const href = item.external ? item.href : buildUrl(item.href);
      return (
        <li class="primary-nav__item">
          <a
            href={href}
            class={`primary-nav__link${active ? ' primary-nav__link--active' : ''}`}
            aria-current={active ? 'page' : undefined}
            rel={item.external ? 'external noopener noreferrer' : undefined}
            target={item.external ? '_blank' : undefined}
          >
            {item.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .primary-nav__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex-wrap: wrap;
  }
  .primary-nav__link {
    display: inline-block;
    padding: 0.375rem 0.625rem;
    font-size: 0.9375rem;
    color: #334155;
    text-decoration: none;
    border-radius: 0.25rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .primary-nav__link:hover { background: #f1f5f9; color: #1d4ed8; }
  .primary-nav__link--active { color: #1d4ed8; background: #eff6ff; }
  .primary-nav__link:focus-visible {
    outline: 2px solid #1d4ed8;
    outline-offset: 2px;
  }
</style>
