---
/**
 * PrimaryNavigation — desktop primary nav from typed configuration.
 * Registry: Site component, M7.
 */
import type { NavigationItem } from '../../types/navigation';
import NavigationBranch from './NavigationBranch.astro';

interface Props {
  items: readonly NavigationItem[];
  currentPath?: string;
  ariaLabel?: string;
}

const { items, currentPath = '', ariaLabel = 'Primary navigation' } = Astro.props;

---

<nav aria-label={ariaLabel} class="primary-nav">
  <ul class="primary-nav__list">
    {items.map((item) => <NavigationBranch item={item} currentPath={currentPath} />)}
  </ul>
</nav>
<style>
  .primary-nav__list { list-style: none; margin: 0; padding: 0.75rem 0; }
</style>
