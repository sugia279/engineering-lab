---
import NavigationIcon from './NavigationIcon.astro';
import type { NavigationItem } from '../../types/navigation';
import { buildUrl } from '../../utils/url';
import { localeUrl, localeFromPath, ui } from '../../lib/i18n';
interface Props { item: NavigationItem; currentPath: string; depth?: number; }
const { item, currentPath, depth = 0 } = Astro.props;
const locale = localeFromPath(currentPath);
const logical = decodeURI(localeUrl(currentPath, 'vi'));
const href = item.external ? item.href : buildUrl(item.href);
const current = logical === decodeURI(href);
function selected(node: NavigationItem): boolean {
  return logical === decodeURI(buildUrl(node.href)) || Boolean(node.matchPattern && logical.includes(decodeURI(node.matchPattern))) || Boolean(node.children?.some(selected));
}
const active = selected(item);
const branch = item.children !== undefined;
---
<li class="nav-node" style={`--depth:${depth}`}>
  {branch ? (
    <>
      <a class:list={['nav-row', 'nav-parent-link', { 'nav-row--active': active }]}
        href={href} data-nav-parent-link title={ui(item.label, locale)} aria-current={current ? 'page' : undefined}>
        {depth < 2 && <NavigationIcon name={item.label} />}
        <span class="nav-label">{item.label}</span>
      </a>
      <details class="nav-branch" data-nav-branch={item.href}>
        <summary class="nav-expander" aria-label={locale === 'vi' ? `Mở hoặc thu gọn ${ui(item.label, locale)}` : `Expand or collapse ${item.label}`}>
          <span class="nav-marker" aria-hidden="true">›</span>
        </summary>
        <ul class="nav-children">
          {item.children?.map((child) => <Astro.self item={child} currentPath={currentPath} depth={depth + 1} />)}
        </ul>
      </details>
    </>
  ) : (
    <a class:list={['nav-row', { 'nav-row--active': active }]} href={href}
      title={ui(item.label, locale)} aria-current={current ? 'page' : undefined}
      rel={item.external ? 'noopener noreferrer' : undefined} target={item.external ? '_blank' : undefined}>
      {depth < 2 ? <NavigationIcon name={item.label} /> : <span class="nav-bullet" aria-hidden="true">·</span>}
      <span class="nav-label">{item.label}</span>
    </a>
  )}
</li>
<style>
  .nav-node { position: relative; }
  .nav-row { display: flex; align-items: flex-start; gap: .6rem; padding: .65rem 1rem .65rem calc(1rem + var(--depth) * .8rem); color: var(--sidebar-text); text-decoration: none; line-height: 1.45; cursor: pointer; font-size: .9rem; }
  .nav-parent-link { padding-right: 2.8rem; }
  .nav-expander { position: absolute; z-index: 1; top: 0; right: 0; display: flex; align-items: center; justify-content: center; width: 2.5rem; height: 2.7rem; cursor: pointer; color: var(--sidebar-text); list-style: none; }
  .nav-expander::-webkit-details-marker { display: none; }
  .nav-expander:hover { color: #e2e8f0; background: #ffffff0f; }
  .nav-marker { font-size: 1.1rem; line-height: 1.2; transition: transform .15s; }
  details[open] > .nav-expander .nav-marker { transform: rotate(90deg); }
  .nav-bullet { flex: 0 0 1.15rem; text-align: center; }
  .nav-label { overflow-wrap: anywhere; min-width: 0; }
  .nav-row:hover { background: #ffffff0f; color: #e2e8f0; }
  .nav-row--active { color: var(--sidebar-text-active); background: #3b82f626; box-shadow: inset -3px 0 var(--sidebar-accent); }
  .nav-children { list-style: none; padding: 0; margin: 0; }
  .nav-row:focus-visible, .nav-expander:focus-visible { outline: 2px solid var(--sidebar-accent); outline-offset: -2px; }
  :global(.app-shell.is-collapsed) .nav-expander, :global(.app-shell.is-collapsed) .nav-label, :global(.app-shell.is-collapsed) .nav-children { display: none; }
  :global(.app-shell.is-collapsed) .nav-row { justify-content: center; padding-inline: .5rem; }
</style>
