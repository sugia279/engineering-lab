---
/**
 * Footer — site footer with social links and copyright.
 * Registry: Site component, M7.
 */
import ExternalLink from '../content/ExternalLink.astro';
import { siteConfig } from '../../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <p class="site-footer__copy">© {year} {siteConfig.author}</p>
  {siteConfig.socialLinks.length > 0 && (
    <ul class="site-footer__links" aria-label="Social links">
      {siteConfig.socialLinks.map((link) => (
        <li>
          <ExternalLink href={link.url} newTab class="site-footer__link">
            {link.service}
          </ExternalLink>
        </li>
      ))}
    </ul>
  )}
</footer>

<style>
  .site-footer {
    grid-area: footer;
    min-width: 0;
    overflow: hidden;
    padding: 0.75rem 1rem;
    background: var(--sidebar-bg);
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    border-right: 1px solid rgba(255, 255, 255, 0.06);
  }
  .site-footer__copy { margin: 0; color: #64748b; font-size: 0.75rem; white-space: nowrap; }
  .site-footer__links {
    list-style: none;
    margin: 0.35rem 0 0;
    padding: 0;
    display: flex;
    gap: 0.625rem;
  }
  .site-footer__link {
    font-size: 0.75rem;
    color: #64748b;
    text-decoration: none;
  }
  .site-footer__link:hover { color: #1d4ed8; text-decoration: underline; }
  .site-footer__link:focus-visible {
    outline: 2px solid #1d4ed8;
    outline-offset: 2px;
    border-radius: 2px;
  }
  :global(.app-shell.is-collapsed) .site-footer__copy,
  :global(.app-shell.is-collapsed) .site-footer__links { opacity: 0; }

  @media (max-width: 767px) { .site-footer { display: none; } }
</style>
