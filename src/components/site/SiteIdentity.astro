---
/**
 * SiteIdentity — site name/logo linking to the home page.
 * Registry: Site component, M7.
 */
import { siteConfig } from '../../config/site';
import { buildUrl } from '../../utils/url';

const homeUrl = buildUrl('/');
---

<a href={homeUrl} class="site-identity" aria-label={`${siteConfig.name} — home`}>
  <span class="site-identity__name">{siteConfig.name}</span>
</a>

<style>
  .site-identity {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .site-identity__name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--topbar-text);
    white-space: nowrap;
  }
  .site-identity:hover .site-identity__name { color: #bfdbfe; }
  .site-identity:focus-visible {
    outline: 2px solid var(--sidebar-accent);
    outline-offset: 3px;
    border-radius: 3px;
  }
  @media (max-width: 639px) { .site-identity { display: none; } }
</style>
