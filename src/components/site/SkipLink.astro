---
/**
 * SkipLink — keyboard accessibility skip-to-main-content link.
 * Registry: Site component, M7.
 */
---

<a href="#main-content" class="skip-link">Skip to main content</a>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 0.5rem;
    z-index: 9999;
    padding: 0.5rem 1rem;
    background: #1d4ed8;
    color: #fff;
    font-weight: 600;
    font-size: 0.9375rem;
    border-radius: 0 0 0.375rem 0.375rem;
    text-decoration: none;
    transition: top 0.1s;
  }
  .skip-link:focus {
    top: 0;
  }
</style>
