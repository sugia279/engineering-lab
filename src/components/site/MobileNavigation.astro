---
/**
 * MobileNavigation — sidebar navigation rendered for the mobile overlay.
 * Registry: Site component, M7.
 */
import type { NavigationItem } from '../../types/navigation';
import PrimaryNavigation from './PrimaryNavigation.astro';

interface Props {
  items: readonly NavigationItem[];
  currentPath?: string;
}

const { items, currentPath = '' } = Astro.props;
---

<div class="mobile-navigation">
  <PrimaryNavigation items={items} currentPath={currentPath} ariaLabel="Mobile navigation" />
</div>

<style>
  .mobile-navigation { display: none; }
  @media (max-width: 767px) { .mobile-navigation { display: block; } }
</style>
