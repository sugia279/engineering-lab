---
import { repository } from '../../config/site';
import { localeFromPath } from '../../lib/i18n';
import { sharedKnowledge } from '../../lib/shared-knowledge';
const vi = localeFromPath(Astro.url.pathname) === 'vi';
const series = [...new Set(sharedKnowledge.map(item => item.series).filter(Boolean))];
---
<section aria-labelledby="add-knowledge">
<h2 id="add-knowledge">{vi ? 'Thêm nội dung Knowledge' : 'Add Knowledge'}</h2>
<p>{vi ? 'Viết bài, ghi chú hoặc thơ và gom vào một chuỗi bài. Cần tài khoản GitHub để gửi; nội dung gửi công khai trên GitHub trước khi duyệt. Bài được duyệt sẽ xuất hiện trong Góc tri thức sau khi website cập nhật.' : 'Write an article, note, or poem and add it to a series. A GitHub account is required; submissions are public on GitHub before moderation. Approved posts appear in Knowledge after the website updates.'}</p>
<form id="knowledge-form" data-repository={repository}>
<label for="knowledge-title">{vi ? 'Tiêu đề' : 'Title'}</label><input id="knowledge-title" name="title" type="text" required minlength="3" maxlength="120" />
<label for="knowledge-kind">{vi ? 'Loại nội dung' : 'Content type'}</label><select id="knowledge-kind" name="kind"><option value="article">{vi ? 'Bài viết' : 'Article'}</option><option value="note">{vi ? 'Ghi chú' : 'Note'}</option><option value="poem">{vi ? 'Thơ' : 'Poem'}</option></select>
<label for="knowledge-category">{vi ? 'Chuyên mục' : 'Category'}</label><input id="knowledge-category" type="text" name="category" required maxlength="60" list="knowledge-categories" /><datalist id="knowledge-categories"><option value="Thơ & sáng tác"></option><option value="Kỹ thuật"></option><option value="Đời sống"></option><option value="Âm nhạc"></option></datalist>
<label for="knowledge-tags">{vi ? 'Tags (cách nhau bằng dấu phẩy)' : 'Tags (comma separated)'}</label><input id="knowledge-tags" type="text" name="tags" required maxlength="490" />
<label for="knowledge-series">{vi ? 'Chuỗi bài (chọn hoặc nhập tên mới; không bắt buộc)' : 'Series (choose or create; optional)'}</label><input id="knowledge-series" type="text" name="series" maxlength="100" list="knowledge-series-list" /><datalist id="knowledge-series-list">{series.map(name => <option value={name}></option>)}</datalist>
<label for="knowledge-order">{vi ? 'Thứ tự trong chuỗi' : 'Order in series'}</label><input id="knowledge-order" type="number" name="order" min="1" max="100000" value="1" required />
<label for="knowledge-body">{vi ? 'Nội dung (giữ nguyên xuống dòng)' : 'Content (line breaks preserved)'}</label><textarea id="knowledge-body" name="body" rows="10" maxlength="12000" required></textarea>
<p>{vi ? 'Tối đa 12 tag, mỗi tag 40 ký tự. Nội dung hiển thị dạng văn bản; không chạy HTML hoặc mã nhúng.' : 'Up to 12 tags of 40 characters. Content is displayed as text; HTML and embed code are not executed.'}</p>
<p id="knowledge-status" role="status"></p><button id="knowledge-submit" class="button" type="submit" disabled>{vi ? 'Tiếp tục trên GitHub →' : 'Continue on GitHub →'}</button>
<noscript><p>{vi ? 'Bật JavaScript để gửi nội dung.' : 'Enable JavaScript to submit.'}</p></noscript>
</form>
</section>
<script>
import { knowledgeMarker, validateKnowledge } from '../../lib/knowledge-submissions.mjs';
import { parseTags, submissionUrl } from '../../lib/submission-fields.mjs';
const form = document.querySelector<HTMLFormElement>('#knowledge-form');
if (form) {
  const vi = document.documentElement.lang === 'vi';
  form.querySelector<HTMLButtonElement>('#knowledge-submit')!.disabled = false;
  form.addEventListener('submit', event => {
    event.preventDefault();
    if (!form.reportValidity()) return;
    const data = new FormData(form);
    const payload = validateKnowledge({ title: data.get('title'), kind: data.get('kind'), category: data.get('category'), tags: parseTags(String(data.get('tags'))), series: data.get('series'), order: Number(data.get('order')), body: data.get('body') });
    const status = document.getElementById('knowledge-status')!;
    if (!payload) { status.textContent = vi ? 'Kiểm tra tiêu đề, nội dung và tags (tối đa 12 tag, mỗi tag 40 ký tự).' : 'Check title, content and tags (up to 12, each 40 characters).'; return; }
    const url = submissionUrl(`[Knowledge] ${payload.title}`, knowledgeMarker, payload, form.dataset.repository!);
    if (!url) { status.textContent = vi ? 'Nội dung quá dài để chuyển bằng liên kết. Hãy rút gọn bài hoặc chia thành nhiều phần trong cùng chuỗi; nội dung vẫn được giữ tại đây.' : 'Too long for a transfer link. Shorten or split into posts in the same series; your text stays here.'; return; }
    location.assign(url);
  });
}
</script>
<style>
section { margin-top: 3rem; border-top: 1px solid #cbd5e1; padding-top: 1.5rem; }
form { display: grid; gap: .6rem; max-width: 46rem; margin-block: 1.5rem; }
label { font-weight: 600; margin-top: .5rem; }
input, select, textarea { width: 100%; padding: .7rem; border: 1px solid #94a3b8; border-radius: .4rem; color: #0f172a; background: white; }
button { justify-self: start; }
</style>
