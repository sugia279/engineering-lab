---
/**
 * GraphControls — domain, collection, and relationship-type filter controls.
 * Registry: Graph component, M7. No framework hydration; native controls only.
 */
import type { GraphQueryState, ConnectionType } from '../../types/graph';
import { DOMAINS } from '../../config/domains';

interface Props {
  state: GraphQueryState;
}

const { state } = Astro.props;

const connectionTypes: { value: ConnectionType; label: string }[] = [
  { value: 'prerequisite', label: 'Prerequisites' },
  { value: 'explains', label: 'Explains' },
  { value: 'extends', label: 'Extensions' },
  { value: 'contrasts', label: 'Contrasts' },
  { value: 'applies-to', label: 'Applied to' },
  { value: 'derived-from', label: 'Derived from' },
  { value: 'related', label: 'Related' },
];

const collections = [
  { value: 'articles', label: 'Articles' },
  { value: 'notes', label: 'Notes' },
  { value: 'projects', label: 'Projects' },
  { value: 'series', label: 'Series' },
] as const;
---

<form class="graph-controls" id="graph-controls" aria-label="Graph filters">
  <fieldset class="graph-controls__group">
    <legend class="graph-controls__legend">Domain</legend>
    <select
      name="domain"
      id="graph-domain-filter"
      class="graph-controls__select"
      aria-label="Filter by domain"
    >
      <option value="">All domains</option>
      {DOMAINS.map((d) => (
        <option value={d.slug} selected={state.domainFilter === d.slug}>
          {d.label}
        </option>
      ))}
    </select>
  </fieldset>

  <fieldset class="graph-controls__group">
    <legend class="graph-controls__legend">Collection</legend>
    <select
      name="collection"
      id="graph-collection-filter"
      class="graph-controls__select"
      aria-label="Filter by collection"
    >
      <option value="">All collections</option>
      {collections.map((c) => (
        <option value={c.value} selected={state.collectionFilter === c.value}>
          {c.label}
        </option>
      ))}
    </select>
  </fieldset>

  <fieldset class="graph-controls__group">
    <legend class="graph-controls__legend">Connection type</legend>
    <select
      name="connectionType"
      id="graph-connection-filter"
      class="graph-controls__select"
      aria-label="Filter by connection type"
    >
      <option value="">All types</option>
      {connectionTypes.map((ct) => (
        <option value={ct.value} selected={state.connectionTypeFilter === ct.value}>
          {ct.label}
        </option>
      ))}
    </select>
  </fieldset>

  <button type="reset" class="graph-controls__reset">Reset filters</button>
  <button type="submit" class="graph-controls__apply">Apply filters</button>
</form>

<style>
  .graph-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: flex-end;
    padding: 1rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 0.5rem;
  }
  .graph-controls__group {
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 10rem;
  }
  .graph-controls__legend {
    font-size: 0.75rem;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 0;
  }
  .graph-controls__select {
    padding: 0.4rem 0.625rem;
    border: 1px solid #cbd5e1;
    border-radius: 0.375rem;
    font-size: 0.9375rem;
    background: #fff;
    color: #1e293b;
    cursor: pointer;
  }
  .graph-controls__select:focus {
    outline: 2px solid #1d4ed8;
    outline-offset: 2px;
    border-color: #3b82f6;
  }
  .graph-controls__reset { padding: 0.4rem 0.875rem; background: transparent; color: #64748b; border: 1px solid #e2e8f0; border-radius: 0.375rem; font-size: 0.875rem; cursor: pointer; align-self: flex-end; }
  .graph-controls__reset:hover { background: #f1f5f9; color: #1e293b; }
  .graph-controls__reset:focus-visible { outline: 2px solid #1d4ed8; outline-offset: 2px; }
  .graph-controls__apply { padding: 0.4rem 0.875rem; background: #1d4ed8; color: #fff; border: none; border-radius: 0.375rem; font-size: 0.875rem; font-weight: 600; cursor: pointer; align-self: flex-end; }
  .graph-controls__apply:hover { background: #1e40af; }
  .graph-controls__apply:focus-visible { outline: 2px solid #1d4ed8; outline-offset: 2px; }
</style>
