---
/**
 * Prose — semantic reading container with MDX typography scope.
 * Registry: Content component, M5.
 */
import '../../styles/prose.css';

interface Props {
  wide?: boolean;
  class?: string;
}

const { wide = false, class: className } = Astro.props;
const classes = ['prose', wide && 'prose--wide', className].filter(Boolean).join(' ');
---

<div class={classes} data-original-content>
  <slot />
</div>
