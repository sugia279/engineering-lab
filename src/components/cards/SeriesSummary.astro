---
/**
 * SeriesSummary — card for series listings, home, topics.
 * Registry: Cards component, M6.
 * Depends on: TagList (M5).
 */
import type { SeriesSummary } from '../../types/content';
import TagList from '../discovery/TagList.astro';

interface Props {
  series: SeriesSummary;
}

const { series } = Astro.props;
---

<article class="series-summary">
  <h3 class="series-summary__title">
    <a href={series.url} class="series-summary__link">
      {series.title}
    </a>
  </h3>
  <p class="series-summary__description">{series.description}</p>
  <footer class="series-summary__meta">
    <span class="series-summary__count" aria-label={`${series.entryCount} entries in series`}>
      {series.entryCount} {series.entryCount === 1 ? 'entry' : 'entries'}
    </span>
    <TagList tags={series.tags} mode="linked" class="series-summary__tags" />
  </footer>
</article>

<style>
  .series-summary {
    padding: 1.25rem 0;
    border-bottom: 1px solid #e2e8f0;
  }
  .series-summary:last-child { border-bottom: none; }
  .series-summary__title { margin: 0 0 0.4rem; font-size: 1.05rem; font-weight: 600; }
  .series-summary__link {
    color: #1e293b;
    text-decoration: none;
  }
  .series-summary__link:hover { color: #1d4ed8; text-decoration: underline; }
  .series-summary__link:focus-visible {
    outline: 2px solid #1d4ed8;
    outline-offset: 2px;
    border-radius: 2px;
  }
  .series-summary__description {
    color: #475569;
    font-size: 0.9375rem;
    margin: 0 0 0.5rem;
    line-height: 1.55;
  }
  .series-summary__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
  }
  .series-summary__count {
    color: #64748b;
    white-space: nowrap;
  }
  .series-summary__tags { flex-shrink: 0; }
</style>
