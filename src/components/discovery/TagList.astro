---
/**
 * TagList — normalized tags as topic links or noninteractive labels.
 * Registry: Discovery component, M5.
 */
import type { Tag } from '../../types/content';
import { topicUrl } from '../../utils/url';
import { sortTags } from '../../utils/tag';

type TagListMode = 'linked' | 'static';

interface Props {
  tags: readonly Tag[];
  mode?: TagListMode;
  class?: string;
}

const { tags, mode = 'linked', class: className } = Astro.props;
const sorted = sortTags(tags);
---

{
  sorted.length > 0 && (
    <ul class={`tag-list${className ? ` ${className}` : ''}`} aria-label="Tags">
      {sorted.map((tag) => (
        <li class="tag-list__item">
          {mode === 'linked' ? (
            <a href={topicUrl(tag.slug)} class="tag-list__link">
              {tag.label}
            </a>
          ) : (
            <span class="tag-list__label">{tag.label}</span>
          )}
        </li>
      ))}
    </ul>
  )
}

<style>
  .tag-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .tag-list__link,
  .tag-list__label {
    display: inline-block;
    font-size: 0.75rem;
    padding: 0.2em 0.6em;
    border-radius: 999px;
    background: #f1f5f9;
    color: #334155;
    text-decoration: none;
    white-space: nowrap;
  }
  .tag-list__link:hover { background: #e2e8f0; }
  .tag-list__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
</style>
