---
/**
 * Pagination — previous/next and page-number navigation.
 * Registry: Discovery component, M7.
 */
import type { PaginationData } from '../../types/navigation';

interface Props {
  pagination: PaginationData;
}

const { pagination } = Astro.props;
const { currentPage, totalPages, previousUrl, nextUrl, pageUrls } = pagination;
---

{
  totalPages > 1 && (
    <nav aria-label="Pagination" class="pagination">
      <ul class="pagination__list" role="list">
        <li>
          {previousUrl ? (
            <a href={previousUrl} class="pagination__link" rel="prev" aria-label="Previous page">
              ← Prev
            </a>
          ) : (
            <span class="pagination__link pagination__link--disabled" aria-disabled="true">
              ← Prev
            </span>
          )}
        </li>

        {pageUrls.map((url, i) => {
          const page = i + 1;
          const isCurrent = page === currentPage;
          return (
            <li>
              {isCurrent ? (
                <span
                  class="pagination__link pagination__link--current"
                  aria-current="page"
                  aria-label={`Page ${page}, current page`}
                >
                  {page}
                </span>
              ) : (
                <a
                  href={url}
                  class="pagination__link"
                  aria-label={`Page ${page}`}
                >
                  {page}
                </a>
              )}
            </li>
          );
        })}

        <li>
          {nextUrl ? (
            <a href={nextUrl} class="pagination__link" rel="next" aria-label="Next page">
              Next →
            </a>
          ) : (
            <span class="pagination__link pagination__link--disabled" aria-disabled="true">
              Next →
            </span>
          )}
        </li>
      </ul>
    </nav>
  )
}

<style>
  .pagination { margin: 2rem 0; }
  .pagination__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
    flex-wrap: wrap;
  }
  .pagination__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.25rem;
    height: 2.25rem;
    padding: 0 0.5rem;
    border-radius: 0.375rem;
    font-size: 0.9375rem;
    text-decoration: none;
    color: #1d4ed8;
    border: 1px solid #e2e8f0;
    background: #fff;
    font-weight: 500;
    white-space: nowrap;
  }
  .pagination__link:not(.pagination__link--current):not(.pagination__link--disabled):hover {
    background: #eff6ff;
    border-color: #3b82f6;
  }
  .pagination__link:focus-visible {
    outline: 2px solid #1d4ed8;
    outline-offset: 2px;
  }
  .pagination__link--current {
    background: #1d4ed8;
    color: #fff;
    border-color: #1d4ed8;
    font-weight: 700;
    cursor: default;
  }
  .pagination__link--disabled {
    color: #94a3b8;
    cursor: default;
    background: #f8fafc;
  }
</style>
