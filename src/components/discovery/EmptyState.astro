---
/**
 * EmptyState — explains a valid empty result with optional recovery action.
 * Registry: Discovery component, M7.
 */
interface Props {
  message: string;
  actionLabel?: string;
  actionHref?: string;
}

const { message, actionLabel, actionHref } = Astro.props;
---

<div class="empty-state">
  <p class="empty-state__message">{message}</p>
  {actionLabel && actionHref && (
    <a href={actionHref} class="empty-state__action">{actionLabel}</a>
  )}
  <slot />
</div>

<style>
  .empty-state {
    padding: 2.5rem 1.25rem;
    text-align: center;
    color: #64748b;
  }
  .empty-state__message { font-size: 1rem; margin: 0 0 1rem; }
  .empty-state__action {
    display: inline-block;
    padding: 0.5rem 1.25rem;
    background: #1d4ed8;
    color: #fff;
    border-radius: 0.375rem;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
  }
  .empty-state__action:hover { background: #1e40af; }
  .empty-state__action:focus-visible {
    outline: 2px solid #1d4ed8;
    outline-offset: 3px;
    border-radius: 0.375rem;
  }
</style>
