---
/**
 * Figure — optimized authored visual with caption and optional attribution.
 * Registry: MDX component, M5.
 */
import { Image } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption: string;
  attribution?: string;
}

const { src, alt, caption, attribution } = Astro.props;
---

<figure class="figure">
  <Image
    src={src}
    alt={alt}
    class="figure__img"
    widths={[400, 800, 1200]}
    sizes="(max-width: 800px) 100vw, 800px"
    loading="lazy"
    decoding="async"
  />
  <figcaption class="figure__caption">
    {caption}
    {attribution && <span class="figure__attribution"> — {attribution}</span>}
  </figcaption>
</figure>

<style>
  .figure {
    margin: 2rem 0;
    text-align: center;
  }
  .figure__img {
    max-width: 100%;
    height: auto;
    border-radius: 0.375rem;
    display: block;
    margin: 0 auto;
  }
  .figure__caption {
    font-size: 0.875rem;
    color: #6b7280;
    margin-top: 0.5rem;
    font-style: italic;
  }
  .figure__attribution {
    font-style: normal;
  }
</style>
