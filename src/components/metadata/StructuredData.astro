---
/**
 * StructuredData — safely serializes JSON-LD structured data into the document head.
 * Registry: Metadata component, M7.
 */
import type { StructuredDataInput } from '../../types/seo';
import { serializeStructuredData } from '../../utils/seo';

interface Props {
  data: StructuredDataInput | StructuredDataInput[];
}

const { data } = Astro.props;
const items = Array.isArray(data) ? data : [data];
---

{items.map((item) => (
  <script
    is:inline
    type="application/ld+json"
    set:html={serializeStructuredData(item)}
  />
))}
