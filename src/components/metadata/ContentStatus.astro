---
/**
 * ContentStatus — visible note maturity or project status badge.
 * Registry: Metadata component, M5.
 */
type NoteMaturity = 'seed' | 'growing' | 'evergreen';
type ProjectStatus = 'active' | 'maintained' | 'completed' | 'archived';
type StatusValue = NoteMaturity | ProjectStatus;

interface Props {
  status: StatusValue;
  label?: string;
}

const { status, label } = Astro.props;

const defaults: Record<StatusValue, string> = {
  seed: 'Seed',
  growing: 'Growing',
  evergreen: 'Evergreen',
  active: 'Active',
  maintained: 'Maintained',
  completed: 'Completed',
  archived: 'Archived',
};

const displayLabel = label ?? defaults[status] ?? status;
---

<span role="img" class={`status status--${status}`} aria-label={`Status: ${displayLabel}`}>
  {displayLabel}
</span>

<style>
  .status {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.15em 0.55em;
    border-radius: 999px;
    white-space: nowrap;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Note maturity */
  .status--seed       { background: #fef9c3; color: #854d0e; }
  .status--growing    { background: #dcfce7; color: #166534; }
  .status--evergreen  { background: #d1fae5; color: #065f46; }

  /* Project status */
  .status--active     { background: #dbeafe; color: #1e40af; }
  .status--maintained { background: #f3e8ff; color: #6b21a8; }
  .status--completed  { background: #f1f5f9; color: #475569; }
  .status--archived   { background: #f1f5f9; color: #94a3b8; }
</style>
