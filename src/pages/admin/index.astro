---
import SiteLayout from '../../layouts/SiteLayout.astro';
import AuthPanel from '../../components/account/AuthPanel.astro';
import { localeFromPath } from '../../lib/i18n';
import { buildSEOData } from '../../utils/seo';
const vi = localeFromPath(Astro.url.pathname) === 'vi';
const seo = buildSEOData({ title: vi ? 'Quản trị' : 'Administration', description: vi ? 'Khu vực quản trị Hien’s Nha.' : 'Hien’s Nha administration.', path: 'admin/', kind: 'listing', noIndex: true });
---
<SiteLayout seo={seo}>
  <section class="room" data-pagefind-ignore><h1>{vi ? 'Quản trị' : 'Administration'}</h1><AuthPanel vi={vi} admin /></section>
</SiteLayout>
