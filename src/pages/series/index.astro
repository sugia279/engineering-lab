---
import { buildUrl } from '../../utils/url';
import { sharedKnowledge } from '../../lib/shared-knowledge';
import ListingLayout from '../../layouts/ListingLayout.astro';
import SeriesSummary from '../../components/cards/SeriesSummary.astro';
import { getPublishedSeries, toSeriesSummary } from '../../lib/content/queries';
import { sortEntries } from '../../lib/content/sort';
import { buildSEOData } from '../../utils/seo';

const allSeries = await getPublishedSeries();
const sorted = sortEntries(allSeries, 'newest');
const summaries = sorted.map(toSeriesSummary);

const seo = buildSEOData({
  title: 'Series',
  description: 'Curated ordered learning paths across topics.',
  path: 'series/',
  kind: 'listing',
});
---

<ListingLayout seo={seo} title="Series" description="Curated ordered learning paths across topics." itemCount={summaries.length + new Set(sharedKnowledge.map(item => item.series).filter(Boolean)).size} activeCollection="series">
  {[...new Set(sharedKnowledge.map(item => item.series).filter(Boolean))].map(name => <a class="room-card" href={buildUrl('knowledge/#shared-knowledge')}><h2 data-original-content>{name}</h2><p>{sharedKnowledge.filter(item => item.series === name).length} bài / posts</p></a>)}
  {summaries.map((s) => <SeriesSummary series={s} />)}
</ListingLayout>
