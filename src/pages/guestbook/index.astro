---
import GuestbookForm from '../../components/site/GuestbookForm.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { buildSEOData } from '../../utils/seo';
import { localeFromPath } from '../../lib/i18n';
import { guestMessages, messageContext } from '../../lib/guestbook';
const vi = localeFromPath(Astro.url.pathname) === 'vi';
const displayTitle = (title: string) => title.replace(/^\[Hien's Nha\]\s*/, '');
const seo = buildSEOData({ title: 'Guestbook', description: vi ? 'Gửi lời nhắn, bình luận hoặc một điều muốn nhờ Hiển.' : 'Leave a message, comment, or request for Hien.', path: 'guestbook/', kind: 'listing' });
---
<SiteLayout seo={seo}>
  <div class="room guestbook">
    <p class="eyebrow">{vi ? 'GHÉ CHƠI, ĐỂ LẠI VÀI DÒNG' : 'SAY HELLO, LEAVE A NOTE'}</p><h1>Guestbook</h1><p class="room-intro">{seo.description}</p>
    <p class="guestbook-notice">{vi ? 'Lời nhắn được gửi công khai qua GitHub và lưu thành file. Bạn cần đăng nhập GitHub và xác nhận gửi ở bước tiếp theo; điền form này chưa lưu lời nhắn. Đừng gửi thông tin riêng tư. Hiển duyệt trước khi lời nhắn xuất hiện ở đây và tại trang được bình luận.' : 'Messages are public on GitHub and archived to files. A GitHub account is required; confirm submission on the next page. Filling this form does not save a message yet. Please keep private information out. Hien approves messages before they appear here and on the commented page.'}</p>
    <GuestbookForm />
    <section class="guestbook-entries" aria-labelledby="guestbook-messages"><h2 id="guestbook-messages">{vi ? 'Những lời nhắn đã duyệt' : 'Approved messages'}</h2>
      {guestMessages.length ? guestMessages.map((message) => (
        <article class="guest-message" data-original-content>
          <h3>{displayTitle(message.title)}</h3>
          <p class="guest-author"><a href={message.author.htmlUrl} rel="noopener noreferrer">@{message.author.login}</a> · <time datetime={message.createdAt}>{new Date(message.createdAt).toLocaleDateString(vi ? 'vi-VN' : 'en-US')}</time></p>
          <p class="guest-body">{message.message}</p>
          {messageContext(message) && <p><a href={messageContext(message)}>{vi ? 'Xem trang được bình luận →' : 'View the commented page →'}</a></p>}
          {message.comments.filter((comment) => comment.trusted).map((comment) => <blockquote><p class="guest-body">{comment.body}</p><cite>@{comment.author.login}</cite></blockquote>)}
          <a href={message.htmlUrl} target="_blank" rel="noopener noreferrer">{vi ? 'Xem thảo luận / trả lời trên GitHub' : 'View discussion / reply on GitHub'}</a>
        </article>
      )) : <p>{vi ? 'Chưa có lời nhắn được duyệt. Bạn có thể là người ghé chơi đầu tiên.' : 'No approved messages yet. You could be the first to say hello.'}</p>}
    </section>
  </div>
</SiteLayout>

<style>
  .guestbook { max-width: 52rem; }
  .guestbook-notice { font-size: 0.9rem; border-left: 3px solid #0f766e; background: #f0fdfa; padding: 1rem; }
  form { margin: 1.5rem 0; display: grid; gap: 0.6rem; }
  label { font-weight: 600; margin-top: 0.5rem; }
  input, textarea, select { width: 100%; padding: 0.7rem; border: 1px solid #94a3b8; border-radius: 0.4rem; background: #fff; color: #0f172a; }
  input:focus-visible, textarea:focus-visible, select:focus-visible { outline: 2px solid #0f766e; outline-offset: 2px; }
  button { justify-self: start; margin-top: 0.75rem; }
  .guestbook-entries { margin-top: 3rem; }
  .guest-message { padding: 1.25rem 0; border-bottom: 1px solid #e2e8f0; }
  .guest-message h3 { font-size: 1.15rem; font-weight: 600; }
  .guest-body { white-space: pre-wrap; overflow-wrap: anywhere; }
  .guest-author { font-size: 0.85rem; }
  blockquote { border-left: 3px solid #99f6e4; padding-left: 1rem; margin: 1rem 0; }
  .guest-message a { color: #0f766e; text-decoration: underline; }
</style>
