---
import MediaForm from '../../components/site/MediaForm.astro';
import { favoriteMedia } from '../../lib/media';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getAllPublishedEntries, toContentSummary } from '../../lib/content/queries';
import { musicPerformances, youtubeEmbed } from '../../lib/music';
import { buildSEOData } from '../../utils/seo';
import { localeFromPath } from '../../lib/i18n';
const vi = localeFromPath(Astro.url.pathname) === 'vi';
const knowledge = (await getAllPublishedEntries()).filter((entry) => entry.data.domains.includes('music')).map(toContentSummary);
const seo = buildSEOData({ title: 'Music & Video', description: vi ? 'Kiến thức âm nhạc, Hiển chơi đàn, cùng những bài nhạc và video yêu thích.' : 'Music knowledge, Hien’s performances, and favorite music and videos.', path: 'music/', kind: 'listing' });
---
<SiteLayout seo={seo}>
  <div class="room">
    <p class="eyebrow">{vi ? 'HỌC NHẠC & CHƠI ĐÀN' : 'LEARN & PLAY'}</p><h1>{vi ? 'Âm nhạc & Video' : 'Music & Video'}</h1><p class="room-intro">{seo.description}</p>
    <section aria-labelledby="music-knowledge"><h2 id="music-knowledge">{vi ? 'Góc kiến thức âm nhạc' : 'Music knowledge'}</h2>
      {knowledge.length ? <div class="room-grid">{knowledge.map((entry) => <a class="room-card" href={entry.url}><h3 data-original-content>{entry.title}</h3><p data-original-content>{entry.description}</p></a>)}</div>
        : <p>{vi ? 'Hiển sẽ ghi lại ở đây những điều học được về nhạc lý, guitar và piano.' : 'Hien will share notes on music theory, guitar, and piano here.'}</p>}
    </section>
    <section class="performances" aria-labelledby="music-performances"><h2 id="music-performances">{vi ? 'Hiển chơi đàn' : 'Hien plays'}</h2>
      {musicPerformances.length ? <div class="room-grid">{musicPerformances.map((video) => <article class="room-card">
        <h3 data-original-content>{video.title}</h3><p data-original-content>{video.description}</p>
        <iframe src={youtubeEmbed(video.youtubeUrl)} title={video.title} loading="lazy" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        <a href={video.youtubeUrl} target="_blank" rel="noopener noreferrer">{vi ? 'Xem trên YouTube' : 'Watch on YouTube'}</a>
      </article>)}</div> : <p>{vi ? 'Chưa có video biểu diễn. Khi Hiển đăng một bản đàn mới, bạn sẽ thấy ở đây.' : 'No performances yet. Hien’s next recording will appear here.'}</p>}
    </section>
    {(['music', 'video'] as const).map((category) => {
      const items = favoriteMedia.filter((item) => item.category === category);
      const heading = category === 'music' ? (vi ? 'Âm nhạc yêu thích' : 'Favorite music') : (vi ? 'Video yêu thích' : 'Favorite videos');
      return <section class="favorites" aria-labelledby={`favorite-${category === 'music' ? 'music' : 'videos'}`}>
        <h2 id={`favorite-${category === 'music' ? 'music' : 'videos'}`}>{heading}</h2>
        {items.length ? <div class="room-grid">{items.map((item) => <article class="room-card">
          <p class="eyebrow">{item.platform}</p><h3 data-original-content>{item.title}</h3>
          <p data-original-content style="white-space: pre-wrap">{item.description}</p>
          <a href={item.url} target="_blank" rel="noopener noreferrer">{vi ? 'Mở trên' : 'Open on'} {item.platform} ↗</a>
        </article>)}</div> : <p>{vi ? 'Chưa có liên kết được duyệt. Bạn có thể gửi gợi ý bên dưới.' : 'No approved links yet. Share a suggestion below.'}</p>}
      </section>;
    })}
    <MediaForm />
  </div>
</SiteLayout>
<style>.performances, .favorites { margin-top: 2.5rem; } iframe { width: 100%; aspect-ratio: 16/9; border: 0; border-radius: 0.5rem; margin: 1rem 0; }</style>
