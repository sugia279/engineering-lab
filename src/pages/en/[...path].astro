---
// English pages reuse the same view and data, rather than a second content tree.
import type { GetStaticPaths } from 'astro';
import Home from '../index.astro';
import About from '../about.astro';
import Resume from '../resume/index.astro';
import Knowledge from '../knowledge/index.astro';
import Novels from '../novels/index.astro';
import Genre from '../novels/genres/[genre].astro';
import { novelGenres } from '../../config/novels';
import Novel from '../novels/[...folder].astro';
import Photos from '../photos/index.astro';
import PhotoUpload from '../photos/upload.astro';
import Music from '../music/index.astro';
import Guestbook from '../guestbook/index.astro';
import Articles from '../articles/index.astro';
import Article from '../articles/[...slug].astro';
import Folder from '../articles/folders/[...folder].astro';
import Notes from '../notes/index.astro';
import Note from '../notes/[...slug].astro';
import Projects from '../projects/index.astro';
import Project from '../projects/[...slug].astro';
import SeriesList from '../series/index.astro';
import Series from '../series/[...slug].astro';
import Topics from '../topics/index.astro';
import Topic from '../topics/[tag].astro';
import Graph from '../graph/index.astro';
import Search from '../search/index.astro';
import NotFound from '../404.astro';
import { getPublishedArticles, getPublishedNotes, getPublishedProjects, getPublishedSeries, getAllTags } from '../../lib/content/queries';
import { getArticleFolders } from '../../lib/content/article-folders';

const views = { Home, About, Resume, Knowledge, Novels, Novel, Genre, Music, Photos, PhotoUpload, Guestbook, Articles, Article, Folder, Notes, Note, Projects, Project, SeriesList, Series, Topics, Topic, Graph, Search, NotFound };

export const getStaticPaths: GetStaticPaths = async () => {
  const [articles, notes, projects, series, tags] = await Promise.all([
    getPublishedArticles(), getPublishedNotes(), getPublishedProjects(), getPublishedSeries(), getAllTags(),
  ]);
  const routes: Array<{ params: { path: string | undefined }; props: { view: string; viewProps: Record<string, unknown> } }> = [];
  const add = (path: string | undefined, view: string, viewProps: Record<string, unknown> = {}) => routes.push({ params: { path }, props: { view, viewProps } });
  const staticViews = { '': 'Home', about: 'About', resume: 'Resume', knowledge: 'Knowledge', novels: 'Novels', music: 'Music', photos: 'Photos', 'photos/upload': 'PhotoUpload', guestbook: 'Guestbook', articles: 'Articles', notes: 'Notes', projects: 'Projects', series: 'SeriesList', topics: 'Topics', graph: 'Graph', search: 'Search', '404': 'NotFound' };
  Object.entries(staticViews).forEach(([path, view]) => add(path || undefined, view));
  novelGenres.forEach((genre) => add(`novels/genres/${genre.id}`, 'Genre', { genre }));
  articles.forEach((entry) => add(`articles/${entry.id}`, 'Article', { entry }));
  notes.forEach((entry) => add(`notes/${entry.id}`, 'Note', { entry }));
  projects.forEach((entry) => add(`projects/${entry.id}`, 'Project', { entry }));
  series.forEach((entry) => add(`series/${entry.id}`, 'Series', { entry }));
  tags.forEach((tag) => add(`topics/${tag.slug}`, 'Topic', { tagSlug: tag.slug, tagLabel: tag.label }));
  getArticleFolders(articles).forEach((folder) => {
    add(`articles/folders/${folder.id}`, 'Folder', { folder });
    if (folder.isNovel) add(`novels/${folder.id}`, 'Novel', { folder });
  });
  return routes;
};

interface Props { view: keyof typeof views; viewProps: Record<string, unknown>; }
const { view, viewProps } = Astro.props as unknown as Props;
const Page = views[view];
---
<Page {...viewProps as any} />
