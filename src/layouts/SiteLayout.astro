---
/**
 * SiteLayout — app shell composing the registered site components.
 * Registry: Layout, M8. All specialized layouts compose this.
 */
import type { SEOData } from '../types/seo';
import type { StructuredDataInput } from '../types/seo';
import DocumentHead from '../components/metadata/DocumentHead.astro';
import StructuredData from '../components/metadata/StructuredData.astro';
import SkipLink from '../components/site/SkipLink.astro';
import PageComments from '../components/site/PageComments.astro';
import PhotoViewer from '../components/photos/PhotoViewer.astro';
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import '../styles/global.css';
import { localeFromPath, localeUrl } from '../lib/i18n';
import { siteConfig } from '../config/site';

interface Props {
  seo: SEOData;
  structuredData?: StructuredDataInput | StructuredDataInput[];
  currentPath?: string;
}

const { seo, structuredData, currentPath = Astro.url.pathname } = Astro.props;
const locale = localeFromPath(currentPath);
const notFound = currentPath.includes('/404');
const ownerUpload = localeUrl(currentPath, 'vi').endsWith('/photos/upload/');
const localizedSeo = { ...seo,
  canonical: notFound ? `${siteConfig.origin}${siteConfig.base}${locale === 'en' ? 'en/404/' : '404.html'}` : new URL(seo.canonical).origin === siteConfig.origin ? siteConfig.origin + localeUrl(new URL(seo.canonical).pathname, locale) : seo.canonical,
  openGraph: { ...seo.openGraph, url: siteConfig.origin + localeUrl(new URL(seo.openGraph.url).pathname, locale) },
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <DocumentHead seo={localizedSeo} />
    {!notFound && <>
      <link rel="alternate" hreflang="vi" href={siteConfig.origin + localeUrl(currentPath, 'vi')} data-locale-link />
      <link rel="alternate" hreflang="en" href={siteConfig.origin + localeUrl(currentPath, 'en')} data-locale-link />
      <link rel="alternate" hreflang="x-default" href={siteConfig.origin + localeUrl(currentPath, 'vi')} data-locale-link />
    </>}
    {structuredData && <StructuredData data={structuredData} />}
  </head>
  <body class="app-shell">
    <SkipLink />
    <Header currentPath={currentPath} />
    <main id="main-content" class="app-main" tabindex="-1" data-pagefind-body data-pagefind-ignore={ownerUpload ? true : undefined}>
      <slot />
      {!notFound && !ownerUpload && !localeUrl(currentPath, 'vi').endsWith('/guestbook/') && <PageComments title={seo.title} />}
    </main>
    <Footer />
    <PhotoViewer />
  </body>
</html>

<style>
  /* ── App shell grid ── */
  .app-shell {
    --topbar-h: 56px;
    --sidebar-w: 240px;
    --sidebar-w-sm: 64px;
    --sidebar-bg: #0f172a;
    --sidebar-text: #94a3b8;
    --sidebar-text-active: #f8fafc;
    --sidebar-accent: #3b82f6;
    --topbar-bg: #1e293b;
    --topbar-text: #f8fafc;
    --transition: 0.2s ease;

    display: grid;
    grid-template-columns: var(--sidebar-w) 1fr;
    grid-template-rows: var(--topbar-h) 1fr auto;
    grid-template-areas:
      "topbar topbar"
      "sidebar main"
      "footer main";
    min-height: 100svh;
    transition: grid-template-columns var(--transition);
  }

  .app-shell.is-collapsed {
    grid-template-columns: var(--sidebar-w-sm) 1fr;
  }

  .app-main {
    grid-area: main;
    min-width: 0;
    overflow: auto;
    outline: none;
  }

  /* ── Mobile: sidebar slides in as overlay ── */
  @media (max-width: 767px) {
    .app-shell {
      grid-template-columns: 0 1fr;
    }
    .app-shell.is-collapsed {
      grid-template-columns: 0 1fr;
    }
  }
</style>
